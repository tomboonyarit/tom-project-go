PORT=8080

# Supabase PostgreSQL — Session Pooler (recommended for pgx)
# ไปที่ Supabase Dashboard → Settings → Database → Connection string → Select "Session pooler"
# รูปแบบ: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxx:your-db-password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# JWT Secret — ใช้ string ยาวๆ สุ่ม (อย่างน้อย 32 ตัวอักษร)
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
